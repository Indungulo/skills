# Hidden files: ignored unless listed here (local agent, editor, env and cache
# directories never belong in the repository)
.*
!.gitignore
!.gitattributes
!.claude-plugin/
!.github/
!.githooks/
!.env.example

# Local validation environments
venv/
env/

# Python caches and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# Editor and OS metadata
Thumbs.db
*.swp
*.swo
*~

# Local secrets and environment files
credentials.json
credentials.yaml
credentials.yml
*.credentials
*.pem
*.key

# EUMDAC/EUMETSAT local data outputs
data/
downloads/
orders/
products/
*.nc
*.h5
*.hdf
*.hdf5
*.nat
*.grib
*.grb
*.zip
*.tar
*.tar.gz
*.tgz
*.metalink
*.xml.tmp

# eval runs
evals/**/results/
